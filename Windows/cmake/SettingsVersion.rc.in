#include <windows.h>
#include "Version.h"

1 ICON "@XMJD_ICON_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION XMJD_VERSION_MAJOR,XMJD_VERSION_MINOR,XMJD_VERSION_PATCH,XMJD_VERSION_BUILD
 PRODUCTVERSION XMJD_VERSION_MAJOR,XMJD_VERSION_MINOR,XMJD_VERSION_PATCH,XMJD_VERSION_BUILD
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "XMJD\0"
      VALUE "FileDescription", "XMJD Windows settings\0"
      VALUE "FileVersion", XMJD_VERSION_WIDE "\0"
      VALUE "InternalName", "XMJDSettings\0"
      VALUE "OriginalFilename", "XMJDSettings.exe\0"
      VALUE "ProductName", "XMJD\0"
      VALUE "ProductVersion", XMJD_VERSION_WIDE "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
